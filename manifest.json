{
  "manifest_version": 3,
  "name": "Gradescope+ : Due Date Countdown & Grade Calculator",
  "version": "1.0.1",
  "description": "Track upcoming Gradescope assignment deadlines and calculate your course grade right on the dashboard. Plus a grade meme.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.gradescope.com/",
        "https://www.gradescope.com/account*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*.png"
      ],
      "matches": [
        "https://www.gradescope.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
